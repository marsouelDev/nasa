# Copier ce fichier en .env (non versionné) puis adapter les valeurs.
# Aucune clé réelle ne doit être commitée.

# --- Django ---
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend autorisé (CORS / CSRF) ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de données ---
# sqlite (développement) ou postgresql (production)
DB_ENGINE=sqlite
# DB_NAME=agrosentry
# DB_USER=agrosentry
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- NASA POWER ---
POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
POWER_TIMEOUT=120
POWER_MAX_RETRIES=3

# --- Africa's Talking (phase 5, laisser vide = mode simulé) ---
AT_USERNAME=
AT_API_KEY=
AT_SHARED_SECRET=
# Expéditeur court (optionnel, selon le compte Africa's Talking)
AT_SENDER_ID=
# Sécurité : True = aucun appel réseau. Pour un envoi réel, il faut aussi
# des clés, SMS_SIMULATION=False et SMS_ENVOI_REEL=True.
SMS_SIMULATION=True
SMS_ENVOI_REEL=False

# --- Celery (phase 5) ---
CELERY_BROKER_URL=memory://
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_BACKEND=cache+memory://
